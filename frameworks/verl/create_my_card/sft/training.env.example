# Copy this file outside the repository, adjust it, then source it before run_sft.sh.

export MODEL_PATH=/mnt/model/Qwen3.6-27B
export DATA_DIR=/workspace/frameworks/verl/create_my_card/sft/data/parquet
export SAVE_PATH=/mnt/data/checkpoints/qwen36-27b-create-my-card-sft-v1

# Existing Qwen3.6 environment in this repository uses Ascend NPU.
# Use TRAIN_DEVICE=cuda on a CUDA veRL environment.
export TRAIN_DEVICE=npu
export NPROC_PER_NODE=16
export MASTER_ADDR=127.0.0.1
export MASTER_PORT=29500

# Token limits are checked against every row with the actual Qwen3.6 chat template.
export MAX_PROMPT_TOKENS=24576
export MAX_OUTPUT_TOKENS=8192
export HARD_MAX_TOTAL_TOKENS=32768
export MAX_LENGTH=auto
export SP_SIZE=auto
export MAX_TOKEN_LEN_PER_GPU=auto

# Full-parameter SFT is the default. A positive rank is an explicit manual switch to LoRA.
export LORA_RANK=0
# These are read only when LORA_RANK is positive:
# export LORA_ALPHA=64
# export LORA_TARGET_MODULES=all-linear
export MICRO_BATCH_SIZE_PER_GPU=1
export TRAIN_BATCH_SIZE=32

# Enable one at a time only after a worst-case dry run reports OOM.
export ACTIVATION_OFFLOAD=false
export OPTIMIZER_OFFLOAD=false
export PARAM_OFFLOAD=false
export USE_TORCH_COMPILE=false

export TOTAL_EPOCHS=3
export LEARNING_RATE=1e-6
export LOGGER=console
export RESUME_MODE=disable

# Keep the default dry run until the longest-sample OOM probe succeeds.
export DRY_RUN=1
export DRY_RUN_STEPS=2
